* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Unreal binary assets go through Git LFS (only matters once you commit editor-authored content).
# GitHub's free LFS quota is 1 GB storage + 1 GB/month bandwidth: the generated Content/NSC assets are
# reproducible from Tools/Setup.bat, so you do not need to commit them at all.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
# launcher UI art is small and must stay a normal git file
launcher/** !filter !diff !merge
